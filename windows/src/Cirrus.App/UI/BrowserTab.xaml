<UserControl x:Class="Cirrus.App.UI.BrowserTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Cirrus.App.UI"
             AllowDrop="True" Focusable="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Photo grid: month headers and rows of tiles -->
        <DataTemplate x:Key="HeaderRow">
            <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" Margin="12,18,0,8" />
        </DataTemplate>
        <DataTemplate x:Key="TileRow">
            <ItemsControl ItemsSource="{Binding Cells}" Margin="8,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Tile" Margin="2" CornerRadius="4" BorderThickness="3" BorderBrush="Transparent" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Width="{Binding TileSize, RelativeSource={RelativeSource AncestorType=ui:BrowserTab}}"
                                Height="{Binding TileSize, RelativeSource={RelativeSource AncestorType=ui:BrowserTab}}"
                                Loaded="Tile_Loaded" MouseLeftButtonDown="Tile_MouseDown" MouseMove="Tile_MouseMove" MouseRightButtonUp="Tile_RightClick" ToolTip="{Binding Name}">
                            <Grid ClipToBounds="True">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="28" Opacity="0.4" />
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="13" Margin="5"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{Binding IsFavorite, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="11" Margin="5" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                <TextBlock Text="LIVE" Foreground="White" FontSize="9" FontWeight="Bold" Margin="5" Opacity="0.9"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding IsLive, Converter={StaticResource BoolVis}}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <ui:PhotoRowSelector x:Key="RowSelector" Header="{StaticResource HeaderRow}" Tiles="{StaticResource TileRow}" />
    </UserControl.Resources>

    <Grid>
        <!-- Details view -->
        <ListView x:Name="DetailsList" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="List_DoubleClick" SelectionChanged="List_SelectionChanged" PreviewMouseLeftButtonDown="List_PreviewMouseDown"
                  PreviewMouseMove="List_PreviewMouseMove" ContextMenuOpening="List_ContextMenuOpening">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="360">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Name" Tag="Name" Click="Header_Click" HorizontalContentAlignment="Left" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Loaded="NameCell_Loaded" DataContextChanged="NameCell_DataContextChanged">
                                    <Grid Width="18" Height="18" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="14" />
                                        <Image Source="{Binding Picture}" Width="18" Height="18" Stretch="Uniform" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="160" DisplayMemberBinding="{Binding DateText}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Date modified" Tag="Date" Click="Header_Click" HorizontalContentAlignment="Left" />
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="150" DisplayMemberBinding="{Binding KindText}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Type" Tag="Kind" Click="Header_Click" HorizontalContentAlignment="Left" />
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="110" DisplayMemberBinding="{Binding SizeText}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Size" Tag="Size" Click="Header_Click" HorizontalContentAlignment="Left" />
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="160" DisplayMemberBinding="{Binding CloudText}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Content="Status" Tag="Cloud" Click="Header_Click" HorizontalContentAlignment="Left" />
                        </GridViewColumn.Header>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Icon view -->
        <ListBox x:Name="IconsList" SelectionMode="Extended" BorderThickness="0" Background="Transparent" Visibility="Collapsed"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="List_DoubleClick" SelectionChanged="List_SelectionChanged" PreviewMouseLeftButtonDown="List_PreviewMouseDown"
                 PreviewMouseMove="List_PreviewMouseMove" ContextMenuOpening="List_ContextMenuOpening">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="104" Margin="2,6" Loaded="IconCell_Loaded">
                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="40" Opacity="0.75" />
                            <Image Source="{Binding Picture}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Photo grid (rows of tiles grouped by month, virtualised by row) -->
        <ListBox x:Name="PhotoGrid" BorderThickness="0" Background="Transparent" Visibility="Collapsed"
                 ItemTemplateSelector="{StaticResource RowSelector}" Focusable="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.ScrollUnit="Pixel"
                 SizeChanged="PhotoGrid_SizeChanged" KeyDown="PhotoGrid_KeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Loading / empty / error -->
        <StackPanel x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="460">
            <ProgressBar x:Name="Spinner" IsIndeterminate="True" Width="160" Height="4" Margin="0,0,0,12" />
            <TextBlock x:Name="OverlayText" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.75" />
            <Button x:Name="OverlayButton" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="14,5" Visibility="Collapsed" Click="OverlayButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>

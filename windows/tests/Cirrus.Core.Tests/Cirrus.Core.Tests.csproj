<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs on macOS/Linux/Windows: dotnet test windows/tests/Cirrus.Core.Tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1416;xUnit1031</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Cirrus.Core/Cirrus.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same vectors as the Swift tests (generated with an independent Python implementation). -->
    <None Include="../../../Tests/CirrusCoreTests/Fixtures/*.txt" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Cirrus.Core" />
  </ItemGroup>
</Project>
